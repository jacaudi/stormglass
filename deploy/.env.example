# stormglass — full-stack compose environment
#
# Copy this file to deploy/.env and fill in real values:
#   cp .env.example .env
# deploy/.env is gitignored and MUST NOT be committed. Every value below is a
# placeholder — none of these are real secrets.

# --- App (stormglass) --------------------------------------------------------

# Optional: WeatherFlow REST API token. Leave unset for the normal full-stack
# deployment described here (UDP listener + observability). Setting TOKEN is
# unchanged by the tokenless-appliance work: it still switches the container
# to API-export mode instead, which serves no UI at all.
TOKEN=

# Optional: process-level station identity (OTel resource attribute
# stormglass.serial). The authoritative per-metric `serial` label always comes
# from the UDP reports themselves, not this value.
STORMGLASS_SERIAL=

# Opt-in radar overlay (design §14). Start the sidecar with:
#   docker compose --profile radar up -d
# RADAR_SITE must be one of the 163 WSR-88D codes in internal/radar/sites.go,
# matched exactly -- it is validated at startup, and a code that is not in the
# table (KTLX, say, or a typo) leaves the card unmounted with an ERROR naming
# the value. FTG is the site nearest the example coordinates below (38 km);
# change both together if you move the station. Enabling this also requires
# STATION_LATITUDE/STATION_LONGITUDE (below) — without them, or without
# RADAR_SITE, the card is not mounted, an ERROR names what's missing, and the
# process keeps running and ingesting.
ENABLE_RADAR=false
RADAR_SITE=FTG

# Opt-in cards (issue #145). Both default to false, and a disabled card is not
# rendered at all rather than left as an empty shell.
# ENABLE_ALMANAC works with no token: it's computed from the local store and
# from computed astronomy. It also needs STATION_LATITUDE/STATION_LONGITUDE
# (below) and an observation store (SQLite is the default) — without them the
# card is not mounted and an ERROR names what's missing.
# ENABLE_FORECAST has no provider yet. The WeatherFlow proxy that used to back
# it was removed (issue #62, closed won't-do); its tokenless NWS replacement
# is issue #81. Leave this false until then.
ENABLE_FORECAST=false
ENABLE_ALMANAC=false

# --- Station identity -------------------------------------------------------
# The store holds no coordinates and UDP carries none, so these are config.
# None is required; a MALFORMED value is a fatal startup error.
# Latitude and longitude must be set together, and are what the almanac and
# radar cards need.
#STATION_NAME=Backyard
#STATION_LATITUDE=39.7392
#STATION_LONGITUDE=-104.9903
#STATION_ELEVATION=1609
# IANA zone for the almanac. Defaults to UTC, which affects more than the
# window boundaries: sunrise/sunset render as UTC clock times (a Denver
# station shows "Sunrise 2:17 PM · Sunset 11:39 PM" on the December
# solstice), the Today/This Week/This Month/This Year windows use UTC
# calendar boundaries, and the record date labels are UTC-dated. Enabling
# the almanac with coordinates but without this logs a WARN at startup.
#STATION_TIMEZONE=America/Denver

# --- Grafana -----------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- MinIO (Litestream's S3-compatible replica target) -----------------------
MINIO_ROOT_USER=stormglass
MINIO_ROOT_PASSWORD=changeme12345

# --- Litestream (SQLite -> MinIO continuous backup) ---------------------------
# Access key/secret here are just the MinIO root creds above (single-tenant
# example deployment); use a scoped MinIO user/policy for anything beyond
# local/dev use.
LITESTREAM_BUCKET=stormglass-backups
LITESTREAM_ACCESS_KEY_ID=stormglass
LITESTREAM_SECRET_ACCESS_KEY=changeme12345

# ------------------------------------------------------------------------------
# ENABLE_POSTGRES variant (documentation only — NOT a second stack; see KISS/YAGNI)
# ------------------------------------------------------------------------------
# Postgres can replace (or run alongside) SQLite+Litestream+MinIO. To use it:
# add a `postgres:` service to docker-compose.yml (image: postgres:16, a named
# volume for /var/lib/postgresql/data, and a healthcheck), then set on the
# stormglass service:
#
#   ENABLE_POSTGRES=true
#   POSTGRES_HOST=postgres
#   POSTGRES_USERNAME=stormglass
#   POSTGRES_PASSWORD=<something-secret>
#   POSTGRES_NAME=weather
#
# See CLAUDE.md's "PostgreSQL Storage (Optional)" section for the full
# variable list (POSTGRES_URL vs. the individual POSTGRES_* components,
# POSTGRES_SSLMODE, POSTGRES_BATCH_SIZE, etc.) and its own Docker Compose
# example. If you don't want a local SQLite file at all, leave SQLITE_PATH
# unset on stormglass and drop the litestream/minio/minio-init services above.
